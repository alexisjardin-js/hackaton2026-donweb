---
import MenuApp from '../components/MenuApp';
import menu from '../data/menu.json';
import '../styles/global.css';
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F1E8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Explorá la carta demostrativa de Il Caminneto en Pueblo Esther, Santa Fe." />
    <title>Il Caminneto · La mesa está servida</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap" rel="stylesheet" />
  </head>
  <body><MenuApp items={menu.items} categories={menu.categories} whatsappNumber={import.meta.env.RESTAURANT_WHATSAPP_NUMBER ?? ''} client:load /></body>
</html>
